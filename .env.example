# OctaneFinder environment (BUILD-CONTRACT §4).
# ALL values are optional for `next build`; features degrade gracefully when unset.
# Copy to `.env.local` for local development and fill in what you need.

# --- Data / runtime ---
# When unset: reads fall back to committed seed JSON (data/stations.seed.json);
# write routes (check-ins, corrections, moderation) return HTTP 503 code:"db_unavailable".
DATABASE_URL=postgres://octane:octane@localhost:5432/octanefinder

# --- Public (NEXT_PUBLIC_*) — safe to expose to the browser ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Stadia / MapTiler style URL; empty => map renders a "configure map" state.
NEXT_PUBLIC_MAP_STYLE_URL=
NEXT_PUBLIC_MAP_ATTRIBUTION=© OpenStreetMap contributors

# --- Auth (next-auth / Auth.js v5) — required only when auth is used ---
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
EMAIL_SERVER=
EMAIL_FROM=

# --- Object storage (DO Spaces / S3 presign) — required only for image uploads ---
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Moderation / rate limiting ---
# Comma-separated emails granted the admin role.
ADMIN_EMAILS=
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000

# In-app driving routes (OSRM-compatible /route/v1/driving API).
# Empty => public OSRM demo server (dev/light use). Self-host OSRM for production scale.
NEXT_PUBLIC_ROUTING_URL=
